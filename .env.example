# CORSIA service environment variables template
# Copy this file to .env and fill in your values.
# 
# This file is sourced by corsia launcher scripts to provide durable config
# across manual starts and UI/agent restarts.
#
# DO NOT COMMIT .env TO GIT — only commit this example file.

# GitHub notifications poller (on by default). The backend reads the signed-in
# gh account's notifications feed (GET only; it never marks anything read) and
# admits new PR and issue comments exactly as POST /webhooks/github would, so
# comments reach their owning agent without a public webhook. It is also off
# under CORSIA_TEST_MODE=1 and while gh is missing or signed out. Its state is
# in GET /api/system under github_notifications. Set to 1 to turn it off.
# export CORSIA_GITHUB_NOTIFICATIONS_DISABLE=1

# Brave Search API key (required for web_search tool)
# Get your key from https://brave.com/search/api/
export BRAVE_API_KEY=your_key_here
