# CORSIA frontend environment variables template
# Copy this file to frontend/.env and fill in your values.
#
# Vite exposes only variables prefixed `PUBLIC_` to the client bundle.
# DO NOT COMMIT .env TO GIT — only commit this example file.

# ─────────────────────────────────────────────────────────────────────
# Product analytics — PostHog (Sprint 4 Slice 3, 00-quality-foundation)
# Configure both values for a separately managed PostHog endpoint.
#
# Without both PUBLIC_POSTHOG_API_KEY and PUBLIC_POSTHOG_HOST,
# emitProductEvent() no-ops silently.
# See docs/observability.md.
# ─────────────────────────────────────────────────────────────────────

PUBLIC_POSTHOG_API_KEY=phc_your_project_api_key_here
PUBLIC_POSTHOG_HOST=
PUBLIC_POSTHOG_PROJECT=corsia
