{
  "name": "frontend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "prepare": "node scripts/generate-build-info.mjs",
    "predev": "node scripts/generate-build-info.mjs",
    "dev": "vite dev",
    "prebuild": "node scripts/generate-build-info.mjs",
    "build": "vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "preview": "vite preview",
    "e2e": "playwright test --grep-invert @visual",
    "e2e:ui": "playwright test --ui",
    "e2e:visual": "CORSIA_VISUAL=1 playwright test --grep @visual",
    "e2e:visual:update": "CORSIA_VISUAL=1 playwright test --grep @visual --update-snapshots",
    "qa": "vitest run && playwright test --grep-invert @visual",
    "qa:select": "node ../qa/core/cli.mjs select",
    "qa:run": "node ../qa/core/cli.mjs run",
    "qa:review": "node ../qa/core/cli.mjs review",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.1",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.6.4",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.53.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tauri-apps/plugin-opener": "^2.5.0",
    "dompurify": "^3.4.11",
    "marked": "^17.0.3",
    "mermaid": "^11.15.0",
    "posthog-js": "^1.373.5",
    "svelte": "^5.53.5",
    "vite": "^7.3.1",
    "y-codemirror.next": "0.3.6",
    "y-indexeddb": "9.0.12",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tauri-apps/cli": "2.10.0",
    "@vitest/coverage-v8": "^4.0.18",
    "jsdom": "^28.1.0",
    "svelte-check": "^4.6.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
