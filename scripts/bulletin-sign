#!/usr/bin/env python3
"""Validate and write a detached Ed25519 signature for one bulletin file."""
from __future__ import annotations

import argparse
import getpass
import sys
from pathlib import Path

from cryptography.hazmat.primitives import serialization


def _load_validator():
    repository = Path(__file__).resolve().parents[1]
    sys.path.insert(0, str(repository / "backend"))
    from infra import bulletin_fetch, bulletins

    return bulletin_fetch, bulletins


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("file", type=Path)
    parser.add_argument("--key", required=True, type=Path)
    args = parser.parse_args()
    content = args.file.read_bytes()
    bulletin_fetch, bulletins = _load_validator()
    _fields, failure = bulletin_fetch.validate_bulletin(content)
    if failure is not None:
        print(f"refusing to sign invalid bulletin: {failure}", file=sys.stderr)
        return 2
    passphrase = getpass.getpass("Private-key passphrase: ").encode()
    try:
        private = serialization.load_pem_private_key(args.key.read_bytes(), password=passphrase)
    except (TypeError, ValueError) as exc:
        print(f"unable to load private key: {exc}", file=sys.stderr)
        return 2
    signature = private.sign(content)
    if bulletins.PUBLIC_KEYS and not bulletins._signature_valid(content, signature):
        print("refusing to sign with a key absent from the shipped PUBLIC_KEYS", file=sys.stderr)
        return 2
    args.file.with_name(args.file.name + ".sig").write_bytes(signature)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
