#!/bin/sh
set -eu

source_path="$0"
while [ -L "$source_path" ]; do
  source_dir="$(CDPATH= cd -- "$(dirname -- "$source_path")" && pwd -P)"
  source_path="$(readlink "$source_path")"
  case "$source_path" in /*) ;; *) source_path="$source_dir/$source_path" ;; esac
done
resources="$(CDPATH= cd -- "$(dirname -- "$source_path")/.." && pwd -P)"
case "${1:-status}" in
  redeploy)
    printf '%s\n' 'Update CORSIA using the app; redeploy is for installations from source.' >&2
    exit 1
    ;;
esac
case "${1:-status}" in
  start|stop|restart|status|logs|open|service|prepare-redeploy|restart-prepared|discard-prepared|ensure-current-release|delegate|doc|context|providers|perf|user|token|local|sources|agent)
    exec "$resources/scripts/corsia" "$@"
    ;;
esac
export PATH="$resources/bin:/usr/bin:/bin:/usr/sbin:/sbin"
export PYTHONNOUSERSITE=1
export PYTHONDONTWRITEBYTECODE=1
export PYTHONPATH="$resources/python/backend-packages"
exec "$resources/python/bin/python3" "$resources/backend/cli.py" "$@"
