#!/bin/sh
set -eu

resources="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)"
contents="$(CDPATH= cd -- "$resources/.." && pwd -P)"
bundle="$(CDPATH= cd -- "$contents/.." && pwd -P)"
state_dir="${CORSIA_STATE_DIR:-$HOME/Library/Application Support/CORSIA}"
mkdir -p "$state_dir/logs"
# The service identity comes from the bundle that launchd started, never an
# inherited shell environment. This makes a replaced bundle observable.
info_plist="$contents/Info.plist"
bundle_short_version="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' "$info_plist")" || exit 1
bundle_version="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleVersion' "$info_plist")" || exit 1
export CORSIA_SERVICE_GENERATION="$bundle_short_version+$bundle_version"
export PYTHONNOUSERSITE=1
export PYTHONDONTWRITEBYTECODE=1
export CORSIA_DESKTOP_BUNDLE=1
login_path="$(PYTHONPATH="$resources/backend" "$resources/python/bin/python3" -c 'from cli_location import login_shell_path; print(login_shell_path() or "")' 2>/dev/null || true)"
base_path="$resources/bin:/usr/bin:/bin:/usr/sbin:/sbin"
# Bundled Git's exec path leads, ahead of the login PATH, so a plain `git` never
# reaches /usr/bin/git, which asks to install the Command Line Tools on a Mac
# without them. It holds only Git's own commands: other bundled tools, such as
# omlx, still come after the person's own.
git_path="$resources/libexec/git-core"
export CORSIA_SERVICE_PATH="$git_path:${login_path:+$login_path:}$base_path"
export PATH="$CORSIA_SERVICE_PATH"
# The bundle owns Git. Avoid host system configuration and credential prompts
# when backend guidance history or spawned harnesses run it.
export GIT_CONFIG_NOSYSTEM=1
export GIT_TERMINAL_PROMPT=0
export PYTHONPATH="$resources/python/backend-packages"
export CORSIA_STATE_DIR="$state_dir"

# service.json (written once by the app shell) names the workspace and port.
# It is parsed, never sourced, and only those two keys are honoured. An
# explicit CORSIA_WORKSPACE or --port still wins, which is what tests use.
service_file_port=""
config_notes=""
if [ -f "$state_dir/service.json" ]; then
  config_notes="$(PYTHONNOUSERSITE=1 "$resources/python/bin/python3" -I -B -c '
import json, sys
KEYS = ("workspace", "port")
def name(value):
    value = str(value)
    ok = value.isprintable() and len(value) <= 64
    return value if ok else "<unprintable name>"
try:
    with open(sys.argv[1], "rb") as handle:
        data = json.loads(handle.read(65536).decode("utf-8"))
    if not isinstance(data, dict):
        raise ValueError("not a JSON object")
except Exception as error:
    print("note=service.json unreadable: " + name(type(error).__name__))
    sys.exit(0)
for key in data:
    if key not in KEYS:
        print("note=service.json: ignoring unsupported key " + name(key))
workspace = data.get("workspace")
if isinstance(workspace, str) and workspace.startswith("/") and workspace.isprintable():
    print("workspace=" + workspace)
elif "workspace" in data:
    print("note=service.json: ignoring an invalid workspace value")
port = data.get("port")
if isinstance(port, int) and not isinstance(port, bool) and 0 < port < 65536:
    print("port=%d" % port)
elif "port" in data:
    print("note=service.json: ignoring an invalid port value")
' "$state_dir/service.json" 2>/dev/null || true)"
  if [ -z "$config_notes" ]; then config_notes="note=service.json: could not be read"; fi
  file_workspace=""
  parsed_notes=""
  while IFS= read -r line; do
    case "$line" in
      workspace=*) file_workspace="${line#workspace=}" ;;
      port=*) service_file_port="${line#port=}" ;;
      note=*) parsed_notes="${parsed_notes}${line#note=}
" ;;
    esac
  done <<EOF_NOTES
$config_notes
EOF_NOTES
  config_notes="$parsed_notes"
  if [ -z "${CORSIA_WORKSPACE:-}" ] && [ -n "$file_workspace" ]; then
    export CORSIA_WORKSPACE="$file_workspace"
  fi
fi

# launchd starts this launcher with no arguments. Scripted invocations retain
# their explicit arguments, while the launchd default is always loopback.
if [ "$#" -eq 0 ]; then
  set -- --host 127.0.0.1
fi
service_port="unknown"
previous_argument=""
for argument; do
  if [ "$previous_argument" = "--port" ]; then
    service_port="$argument"
    break
  fi
  case "$argument" in
    --port=*) service_port="${argument#--port=}"; break ;;
  esac
  previous_argument="$argument"
done
if [ "$service_port" = "unknown" ] && [ -n "$service_file_port" ]; then
  service_port="$service_file_port"
  set -- "$@" --port "$service_port"
fi
# The backend finds its own loopback port through BACKEND_PORT (the Claude Code
# tool bridge URL, scheduled updates, the CLI); unset, it falls back to the
# default port, which the packaged app does not serve on.
if [ "$service_port" != "unknown" ]; then
  export BACKEND_PORT="$service_port"
fi
exec >>"$state_dir/logs/service.log" 2>&1
# Refuse to compete with a different CORSIA job. A deliberate refusal exits
# successfully so KeepAlive does not turn PK4 into a respawn loop.
launchctl_command="${CORSIA_TEST_LAUNCHCTL:-launchctl}"
# `launchctl print gui/<uid>` only summarizes the domain. List candidate
# labels first, then inspect each job's own record before comparing its program
# with this bundle. Do not start if either inspection is unavailable: a clean
# exit prevents KeepAlive from racing an uninspectable foreign CORSIA service.
if ! corsia_jobs="$("$launchctl_command" list 2>/dev/null)"; then
  printf 'CORSIA bundled backend refused to start: could not inspect CORSIA service list\n'
  exit 0
fi
corsia_labels="$(printf '%s\n' "$corsia_jobs" | awk '$3 ~ /^(com|ai)\.corsia\./ { print $3 }')"
foreign_corsia_label=""
while IFS= read -r label; do
  [ -n "$label" ] || continue
  if ! job="$("$launchctl_command" print "gui/$(id -u)/$label" 2>/dev/null)"; then
    printf 'CORSIA bundled backend refused to start: could not inspect CORSIA service %s\n' "$label"
    exit 0
  fi
  program="$(printf '%s\n' "$job" | awk '
    /^[[:space:]]*(path|program) = / { value=$3; gsub(/^"|"$/, "", value); print value; exit }
  ')"
  if [ -z "$program" ] || [ "${program#"$bundle"/}" = "$program" ]; then
    foreign_corsia_label="$label"
    break
  fi
done <<EOF_CORSIA_LABELS
$corsia_labels
EOF_CORSIA_LABELS
if [ -n "$foreign_corsia_label" ]; then
  printf 'CORSIA bundled backend refused to start: foreign CORSIA service %s owns this Mac\n' "$foreign_corsia_label"
  exit 0
fi
printf 'CORSIA bundled backend startup: state_dir=%s db_path=%s port=%s workspace=%s generation=%s\n' \
  "$state_dir" "$state_dir/corsia.db" "$service_port" "${CORSIA_WORKSPACE:-unset}" "$CORSIA_SERVICE_GENERATION"
printf 'CORSIA bundled backend: git=%s\n' "$(command -v git || echo none)"
printf '%s' "$config_notes" | while IFS= read -r note; do
  if [ -n "$note" ]; then printf 'CORSIA bundled backend: %s\n' "$note"; fi
done
exec "$resources/python/bin/python3" -m uvicorn main:app --app-dir "$resources/backend" "$@"
