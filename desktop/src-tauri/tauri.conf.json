{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CORSIA",
  "version": "0.1.0",
  "identifier": "com.cebertowicz.corsia",
  "build": {
    "frontendDist": "../dist-shell",
    "devUrl": "http://localhost:5273"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "CORSIA",
        "width": 1280,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true,
        "decorations": true,
        "trafficLightPosition": { "x": 23, "y": 23 },
        "windowEffects": {
          "effects": ["sidebar"],
          "state": "active"
        }
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.icns",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
