{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CORSIA",
  "version": "0.1.0",
  "identifier": "ai.corsia.app",
  "build": {
    "frontendDist": "../dist-shell",
    "devUrl": "http://localhost:5273"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "CORSIA",
        "width": 1280,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true,
        "decorations": true,
        "trafficLightPosition": { "x": 23, "y": 23 },
        "windowEffects": {
          "effects": ["sidebar"],
          "state": "active"
        }
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJFQTkzRTc4OTM0NjJFQjcKUldTM0xrYVRlRDZwTHVXSHVXR21sUTJIOW1xREZ1bElXRG1PQnFGT2dhSlBUaDgrR2g5MEs5Mk4K",
      "endpoints": [
        "https://github.com/cebertowicz/corsia/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "resources": {
      "../bundle/bin/corsia": "bin/corsia",
      "../bundle/bin/corsia-service": "bin/corsia-service",
      "../bundle/bin/omlx": "bin/omlx",
      "../bundle/bin/git": "bin/git",
      "../bundle/bin/agent-browser": "bin/agent-browser",
      "../bundle/libexec": "libexec",
      "../bundle/share": "share",
      "../bundle/licenses": "licenses",
      "../bundle/python": "python",
      "../bundle/backend": "backend",
      "../bundle/frontend": "frontend",
      "../bundle/scripts": "scripts",
      "../bundle/updater-endpoint.json": "updater-endpoint.json"
    },
    "icon": [
      "icons/icon.icns",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "macOS": {
      "minimumSystemVersion": "15.0",
      "entitlements": "Entitlements.plist",
      "infoPlist": "Info.plist"
    }
  }
}
