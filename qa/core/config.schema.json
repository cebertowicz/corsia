{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["version", "projectName", "paths"],
  "properties": {
    "version": { "type": "integer" },
    "projectName": { "type": "string" },
    "adapter": { "type": "string" },
    "paths": {
      "type": "object",
      "required": ["artifacts", "impactMap", "surfaceCatalog"],
      "properties": {
        "artifacts": { "type": "string" },
        "impactMap": { "type": "string" },
        "surfaceCatalog": { "type": "string" },
        "reviewPrompt": { "type": "string" },
        "toolCandidates": { "type": "string" },
        "designSystem": { "type": "string" }
      }
    },
    "artifactInputs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "catalog": {
      "type": "object",
      "properties": {
        "routes": { "type": "array", "items": { "type": "string" } },
        "components": { "type": "array", "items": { "type": "string" } },
        "api": { "type": "array", "items": { "type": "string" } }
      }
    },
    "llm": {
      "type": "object",
      "properties": {
        "baseUrlEnv": { "type": "string" },
        "apiKeyEnv": { "type": "string" },
        "modelEnv": { "type": "string" },
        "defaultModel": { "type": "string" },
        "maxImages": { "type": "integer" }
      }
    }
  }
}
